<?xml version="1.0" encoding="utf-8"?>
<!-- Nichts verlässt das Gerät: weder in eine Cloud-Sicherung noch beim
     Umzug auf ein neues Telefon. Der API-Schlüssel liegt im Schlüsselspeicher
     des Geräts und wäre anderswo ohnehin nicht zu entschlüsseln. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
